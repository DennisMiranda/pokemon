---
import "./src/styles/global.css";
const { title = "Pokémon App" } = Astro.props;
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
  </head>
  <body class="bg-gray-900 text-white font-sans">
    <header
      class="bg-yellow-500 text-gray-900 text-center py-6 text-2xl font-bold shadow-md"
    >
      {title}
    </header>
    <main>
      <slot />
    </main>
  </body>
</html>
